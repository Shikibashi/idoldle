[Unit]
Description=Idoldle Vite preview (static dist/) on 127.0.0.1:4173
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/home/tcs/Code/idoldle
# npx's shebang is `#!/usr/bin/env node` — without linuxbrew on PATH,
# the env lookup fails. Inject the linuxbrew bin dir explicitly.
Environment=PATH=/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
# Invoke vite directly from the project's node_modules to avoid npx
# auto-installing an unrelated global copy.
ExecStart=/home/linuxbrew/.linuxbrew/bin/node /var/home/tcs/Code/idoldle/node_modules/vite/bin/vite.js preview --host 127.0.0.1 --port 4173 --strictPort
Restart=always
RestartSec=5

# Modest hardening — user services can't match system-unit lockdowns
# because they share the user's SELinux context (user_u:user_r:user_t).
# We leave the heavy-duty sandboxing (Protect* etc.) off because uBlue's
# targeted policy denies too many required paths to systemd-user.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
