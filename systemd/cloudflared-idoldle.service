[Unit]
Description=Cloudflare tunnel for idoldle.edriffles.us
After=network-online.target idoldle-preview.service
Wants=network-online.target
Requires=idoldle-preview.service

[Service]
Type=simple
ExecStart=/home/linuxbrew/.linuxbrew/bin/cloudflared tunnel --config /var/home/tcs/.cloudflared/config.yml run idoldle
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
